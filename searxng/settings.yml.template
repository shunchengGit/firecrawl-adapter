use_default_settings: true

general:
  instance_name: "hermes-search"
  debug: false
  privacypolicy_url: false
  contact_url: false
  enable_metrics: false

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json

server:
  secret_key: "hermes-searxng-local"
  bind_address: "0.0.0.0"
  port: 8080
  limiter: false
  image_proxy: false
  method: "GET"

ui:
  static_use_hash: true
  default_theme: simple
  default_locale: ""

# 引擎选择：9 个稳定引擎。原生 google 与 startpage（需解 Anubis POW，且代理出口
# 实测持续触发 CAPTCHA）均禁用；补充国内 Quark 与实测稳定的 fynd（fynd.bot）聚合。
# zapmeta 因代理出口 IP 被其风控（unusual traffic）暂不启用，定义保留便于日后恢复。
engines:
  # 国内引擎
  - name: 360search
    disabled: false
    timeout: 15.0
  - name: quark
    disabled: false
    timeout: 15.0

  # 国际引擎（走代理）
  - name: bing
    disabled: false
    timeout: 15.0
  - name: google
    disabled: true
  - name: startpage
    disabled: true
  - name: duckduckgo
    disabled: true
  - name: wikipedia
    disabled: false
    timeout: 10.0

  # fynd（fynd.bot 聚合）：连发 7 轮全部稳定，中英文均相关，抗风控表现最好
  - name: fynd
    disabled: false
    timeout: 15.0

  # 直连可用
  - name: yandex
    disabled: false
    timeout: 15.0
  - name: presearch
    disabled: false
    timeout: 15.0
  - name: mojeek
    disabled: true

  # 持续 CAPTCHA/被墙/不可用
  - name: baidu
    disabled: true
  - name: sogou
    disabled: true
  - name: brave
    disabled: true
  - name: qwant
    disabled: true
  - name: wikidata
    disabled: true
  - name: yahoo
    disabled: true
  - name: aol
    disabled: true
  - name: seznam
    disabled: true
  - name: naver
    disabled: true

  # zapmeta：2026.5.16 镜像默认配置无此条目，需内联完整 xpath 定义。
  # 当前代理出口 IP 被其风控（unusual traffic），暂禁用；解除后可改回 disabled: false。
  - name: zapmeta
    engine: xpath
    shortcut: zpm
    categories: general
    search_url: https://www.zapmeta.com/search?q={query}&pg={pageno}
    results_xpath: //article[contains(@class, "organic-results-item")]
    url_xpath: ./h2/a/@href
    title_xpath: ./h2
    content_xpath: ./p
    paging: true
    disabled: true
    timeout: 15.0
    about:
      website: https://www.zapmeta.com/
      use_official_api: false
      require_api_key: false
      results: HTML

outgoing:
  request_timeout: 20.0
  max_request_timeout: 30.0
  useragent_suffix: ""
  pool_connections: 100
  pool_maxsize: 6
  enable_http2: false
  # 全局代理：容器内 → host.docker.internal → 宿主代理 (7890)
  proxies:
    http: "__SEARXNG_PROXY__"
    https: "__SEARXNG_PROXY__"
